  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f153fe153f18ea88227af5b304989c",
        "question": [
          "Revenue by Order Priority"
        ],
        "sql": [
          "SELECT\n",
          "  o_orderdate     AS Date,\n",
          "  o_orderpriority AS Priority,\n",
          "  sum(o_totalprice) AS TotalPrice\n",
          "FROM\n",
          "  `samples`.`tpch`.`orders`\n",
          "WHERE\n",
          "  o_orderdate > '1994-01-01'\n",
          "  AND o_orderdate < '1994-01-31'\n",
          "GROUP BY\n",
          "  1, 2\n",
          "ORDER BY\n",
          "  1, 2"
        ]
      }
    ],
